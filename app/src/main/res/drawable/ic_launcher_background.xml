<?xml version="1.0" encoding="utf-8"?>
<!--
    圖示背景：沿用 iOS 版本圖示的那道橘色漸層。
    色值是從 iOS 的 icon_1024.png 實際取樣出來的（左上 #FF792A、右下 #FF5109），
    與 `Tokens.primaryGradient` 是同一組——App 內的主色 CTA 用的就是它。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF792A" />
                <item android:offset="1" android:color="#FF5109" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
