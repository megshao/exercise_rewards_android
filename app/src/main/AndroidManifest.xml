<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 唯一需要的權限。刻意不宣告任何健康資料、位置、相機權限：
         運動紀錄一律由使用者自己從相簿挑選（照 iOS 端的設計）。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        **移掉 Firebase Analytics 自動塞進來的三個廣告權限。**

        `play-services-measurement-impl` 會宣告 `AD_ID`（讀取 Google 廣告識別碼），
        `play-services-measurement-api` 會宣告兩個 Privacy Sandbox 的 AdServices 權限。
        這個 App 沒有廣告、沒有廣告歸因、沒有跨 App 追蹤——留著它們有兩個實際代價：

        1. Play 的「資料安全」表單必須勾「收集廣告識別碼」，那是一句假話。
        2. 使用者在系統設定裡看 App 權限時會看到「廣告識別碼」，而我們的隱私權
           頁面正好在保證不做這件事。權限清單是使用者能自己查核的第一層證據，
           它必須跟文件一致。

        移掉 `AD_ID` 是 Google 官方文件記載的做法（Analytics 會改用不含廣告 ID 的
        識別）。兩個 AdServices 權限只有歸因回報路徑會用到，沒有廣告來源可歸因時
        本來就不會被呼叫。

        ⚠️ **`gplay preflight` 會對這件事發 warning，那條不要照它的 hint 修**：
        「an ads/attribution SDK is present but AD_ID is not declared (targetSdk 37)
        ... without it the SDK reads zeros」。工具假設你想要廣告識別碼；我們不要，
        「reads zeros」正是預期結果——那條 warning 反而是移除確實生效的獨立證據。
        把權限加回去會讓 Data safety 必須改答「收集廣告識別碼」，並與
        site/privacy.html 第 4 節的承諾直接矛盾。詳見 docs/play-store/gplay-setup.md §4。

        驗證方式：`./gradlew :app:processReleaseMainManifest` 之後跑下面這段，
        應該印出 `AD_ID 命中: 0`。**不要直接對固定路徑下 grep -c**：AGP 的
        intermediates 路徑會隨版本改（這裡同時存在 merged_manifest 與
        merged_manifests 兩個目錄），路徑一錯 grep -c 就印 0——看起來像通過，
        其實什麼都沒檢查到。

        M=$(find app/build/intermediates -name AndroidManifest.xml -path "*merged_manifest/release/*" | head -1)
        [ -n "$M" ] || { echo "找不到合併後的 manifest，先 build"; exit 1; }
        echo "AD_ID 命中: $(grep -c AD_ID "$M")"
    -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <application
        android:name=".ExerciseRewardsApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.ExerciseRewards">

        <!--
            **把 Firebase 的自動初始化拆掉。這一行是「同意後才初始化」這個承諾的實作。**

            firebase-common 會自己往 manifest 塞一個 `FirebaseInitProvider`。ContentProvider
            的 onCreate **早於 Application.onCreate**，所以只要設定檔在，Firebase 就會在
            App 啟動的那一刻被初始化——使用者連免責聲明都還沒看到。那會讓 README 裡
            「同意之前不該出現任何 Google 網域」變成一句做不到的話。

            這是 Android 特有的坑：iOS 端的 `FirebaseApp.configure()` 本來就要手動呼叫，
            不做這件事也不會有問題。移掉之後由 `Telemetry.configure()` 明確初始化，
            兩個平台的行為才真的一致。

            移掉之前實測（logcat）：`FirebaseInitProvider: FirebaseApp initialization ...`
            會出現在 process 啟動當下。移掉之後那一行完全不該出現，直到使用者按下同意。
        -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            android:exported="false"
            tools:node="remove" />

        <!--
            縱深防禦：就算哪天有人把上面那個 provider 加回來，這兩個旗標也讓 SDK
            在被明確打開之前不主動蒐集。執行期的 setAnalyticsCollectionEnabled(true)
            會覆蓋它們（見 Telemetry.applyUserPreference），所以同意之後照樣運作。
        -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <!-- 不做廣告歸因，關掉相關訊號。 -->
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ExerciseRewards">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
